# Research Analyst environment example
#
# This file is safe-by-default. Copy it to .env, replace placeholders, and
# enable delivery only after the executor paper path and protections are tested.

# -----------------------------------------------------------------------------
# Local databases and durable trigger spool
# -----------------------------------------------------------------------------
MARKET_DB_PATH=./data/market.sqlite3
ANALYST_DB_PATH=./data/analyst.sqlite3
REGIME_DB_PATH=./data/regime.sqlite3
EVALUATION_TRIGGER_DIR=./data/evaluation_triggers
EVALUATION_RECOVERY_SCAN_SECONDS=5
EVALUATION_LEASE_SECONDS=600
EVALUATION_MAX_RETRIES=5
DATA_FRESHNESS_MAX_SECONDS=600

# -----------------------------------------------------------------------------
# Performance rotation and public market data
# -----------------------------------------------------------------------------
# The rotation worker publishes 30 rotating assets plus BTC, ETH, PAXG, and QQQ.
SYMBOL_ROTATION_ENABLED=true
SYMBOL_ROTATION_REFRESH_HOURS=4
SYMBOL_ROTATION_LOOKBACK_HOURS=24
SYMBOL_ROTATION_ROTATING_SYMBOL_COUNT=30
SYMBOL_ROTATION_BAR_INTERVAL=5m
SYMBOL_ROTATION_FEED_PATH=./data/symbol_rotation_feed.json
SYMBOL_ROTATION_SOURCE_MAX_AGE_HOURS=6

WS_BYBIT_ENABLED=true
WS_BINANCE_ENABLED=false
WS_STREAM_TIMEFRAMES=1m,5m
WS_MARKPRICE_ENABLED=true
WS_BYBIT_SHARD=20
WS_STALE_SECONDS=180
# At least 228 hours are needed to seed 57 complete 4h bars for regime ADX.
WS_BACKFILL_HOURS=240
DEEP_BACKFILL_HOURS=240
WS_RESAMPLE_LOOKBACK_MIN=1440

# The Binance OI scanner is a separate project and database. It is not the
# primary market-data feed for this service.
BINANCE_OI_ROTATION_ENABLED=false
ROTATION_FEED_ENABLED=false
COINANALYZE_EVAL_ENABLED=false
LEGACY_SCANNER_ENABLED=false

# Gateway triggers are emitted for completed 1m and 5m base observations.
EVAL_INTERVALS=1m,5m,15m

# -----------------------------------------------------------------------------
# Regime-session gate
# -----------------------------------------------------------------------------
# shadow records hypothetical blocks but evaluates the full universe.
REGIME_SESSION_MODE=shadow
REGIME_SESSION_GRACE_SECONDS=30
REGIME_SESSION_COOLDOWN_MINUTES=30
REGIME_SESSION_FAMILY_ON_THRESHOLD=0.35
REGIME_SESSION_FAMILY_OFF_THRESHOLD=0.25
REGIME_SCORE_ADX_NORMALIZATION=50
REGIME_SCORE_ADX_LENGTH=14
REGIME_SCORE_ADX_SMOOTHING=14
REGIME_SCORE_VOL_WINDOW_BARS=12
REGIME_SCORE_TRANSITION_CENTER_UTC_MINUTE=780
REGIME_SCORE_TRANSITION_WIDTH_MINUTES=60
REGIME_SCORE_TRANSITION_MIN_DISCOUNT=0.5
REGIME_SCORE_REVERSAL_MIN_PRIOR_TREND=0.55
REGIME_SCORE_REVERSAL_DECAY_MIN=0.15
# Direct regime-only Bybit 4h history; strategy-facing 4h remains 5m-resampled.
REGIME_4H_FETCH_DAYS=15
REGIME_4H_RETAIN_DAYS=14
REGIME_4H_READINESS_BARS=57
REGIME_4H_REQUEST_TIMEOUT_SECONDS=20

# Entry-policy observations are also shadow-only in this example.
ENTRY_POLICY_MODE=shadow
ENTRY_POLICY_COOLDOWN_MINUTES=30

# -----------------------------------------------------------------------------
# Production strategy allowlist
# -----------------------------------------------------------------------------
STRATEGY_ENABLED_IDS=failed-break-v3,bb-rsi-meanrev-v1,williams-fractal-scalp-v1,ema9-adx-stochrsi-state-v1,dual-zone-follower-v2,dual-zone-short-follower-v2,ema20-pullback-h4-trend-v1,gold-trend-ema-bb-stoch-v1,mtf-exhaustion-reversal-v1,ema99-double-touch-stochrsi-state-v1,ema7-26-cross-hammer-shooting-star-1h-adx-v1
STRATEGY_ACTIVE_IDS=

# -----------------------------------------------------------------------------
# Shared SQLite intent bus and executor handoff
# -----------------------------------------------------------------------------
# The path must be absolute when bus publishing is enabled. These switches are
# deliberately off here; production enables them only after validation.
INTENT_BUS_PACKAGE_DIR=/home/ubuntu/shared/intent-bus
INTENT_BUS_DB=/home/ubuntu/shared/intent-bus/intent_bus.sqlite3
INTENT_DELIVERY_ENABLED=false
INTENT_BUS_BYBIT_ENABLED=false
INTENT_BUS_PROPR_ENABLED=false
INTENT_BUS_LEGACY_INBOX_ENABLED=false

BYBIT_EXECUTOR_DIR=/home/ubuntu/bybit-executor
INTENT_SOURCE=research-analyst
INTENT_EXCHANGE_ID=bybit
INTENT_ACCOUNT_ID=hyro
INTENT_TAKE_PROFIT_MODE=fixed_full_close
INTENT_VALIDITY_MINUTES=5
INTENT_MIN_RR=2.0
INTENT_MIN_STOP_DISTANCE_PCT=0.001
INTENT_MIN_STOP_ATR_MULTIPLIER=0.25
INTENT_MAX_STOP_DISTANCE_PCT=0.05
STRUCTURAL_STOP_ADMISSION_ENABLED=false
STRUCTURAL_STOP_REQUIRED_STRATEGIES=
STRUCTURAL_STOP_MAX_REFERENCE_GAP_PCT=

# -----------------------------------------------------------------------------
# PM sidecar
# -----------------------------------------------------------------------------
# PM is independent from research LLM review. It reads executor snapshots and
# writes PMDecision files to the executor-owned decision directory.
PM_SIDECAR_ENABLED=true
PM_CADENCE_MINUTES=5
EXECUTOR_SNAPSHOT_DIR=/home/ubuntu/bybit-executor/data/position-snapshots
EXECUTOR_DECISION_DIR=/home/ubuntu/bybit-executor/data/position-decisions
PM_LLM_TIMEOUT_S=20
PM_LLM_RETRIES=1
PM_REDUCE_FRACTION=0.5
PM_DECISION_VALIDITY_MINUTES=5
PM_ACTION_CONFIDENCE=0.70
PM_NEAR_TP_REDUCE_FRACTION=0.75

# LLM research review remains disabled in the live evaluation path.
LLM_RESEARCH_ENABLED=false
LLM_PROVIDER=openai
LLM_BASE_URL=http://127.0.0.1:20128/v1
LLM_MODEL=replace_with_model_name
LLM_API_KEY=replace_with_llm_key
LLM_TIMEOUT_SECONDS=20
LLM_MAX_REPORTS_PER_CYCLE=2
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=60
LLM_MAX_INPUT_CHARS=24000
LLM_MAX_OUTPUT_CHARS=6000
LLM_MONTHLY_BUDGET_USD=0
LLM_INCLUDE_IN_TELEGRAM=false
LLM_INCLUDE_IN_DISCORD=false

# -----------------------------------------------------------------------------
# Optional public notifications
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=
DISCORD_ALPHA_WEBHOOK_URL=
DISCORD_OI_WEBHOOK_URL=
RAW_SIGNAL_DISCORD_BATCH_ENABLED=false
RAW_SIGNAL_DISCORD_BATCH_MINUTES=30
RAW_SIGNAL_DISCORD_WEBHOOK_URL=
RAW_BATCH_CLAIM_LEASE_SECONDS=120
RAW_BATCH_MAX_ATTEMPTS=5

# -----------------------------------------------------------------------------
# Retention
# -----------------------------------------------------------------------------
PRUNE_1M_DAYS=7
PRUNE_5M_DAYS=30
PRUNE_15M_DAYS=90
PRUNE_1H_DAYS=365
PRUNE_4H_DAYS=365
DB_MAINTENANCE_ENABLED=true
DB_MAINTENANCE_INTERVAL_SECONDS=3600
DB_MAINTENANCE_VACUUM_INTERVAL_SECONDS=86400
ANALYST_SNAPSHOT_RETENTION_DAYS=2
ANALYST_CUTOFF_RETENTION_DAYS=30
ANALYST_PIPELINE_RETENTION_DAYS=30
ANALYST_RAW_SIGNAL_RETENTION_DAYS=90
ANALYST_CANDIDATE_RETENTION_DAYS=90
ANALYST_EVENT_RETENTION_DAYS=365
ANALYST_PM_RETENTION_DAYS=30
ANALYST_DELIVERY_RETENTION_DAYS=365
ANALYST_METRICS_RETENTION_DAYS=30
ANALYST_RESEARCH_RETENTION_DAYS=30
ANALYST_DISCOVERY_RETENTION_DAYS=90
ANALYST_WATCHLIST_RETENTION_DAYS=365

# Non-trading health integration.
RESEARCH_HEALTH_PATH=./data/health.json
