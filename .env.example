# CoinAnalyze Configuration
# Register on coinalyze.net to get your API key
COINANALYZE_API_KEY=your_coinalyze_api_key_here

# Telegram Bot Configuration
# Create a bot via @BotFather on Telegram to get your token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Can be a user ID, group ID, or channel username (e.g. -100xxxxxxxxx or @channelname)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Database Configuration
# Relative or absolute path to the DuckDB database file
DB_PATH=./data/market_data.db

# Scheduling & Ingestion Configuration
# Run the ingestion loop every X minutes (daemon default: 15)
INGEST_INTERVAL_MINS=15
# Keep raw futures data for alpha research (0 disables pruning; default: 365)
FUTURES_RETENTION_DAYS=365
# Scanner research universe: require this much Binance 24h USDT notional
SCANNER_MIN_24H_VOLUME_USD=5000000
# Classify contracts at or above this Binance 24h USDT notional as core
SCANNER_CORE_24H_VOLUME_USD=100000000
# Number of liquid contracts sent to CoinAnalyze for detailed hourly scanning
SCANNER_MAX_CONTRACTS=50
# Time to send the daily brief (in WITA / Asia/Makassar timezone)
DAILY_BRIEF_TIME_WITA=08:00

# Regime Signal Configuration
# (Data is sourced from the DuckDB futures_data table — no external files needed)
