# CoinAnalyze Configuration
# Register on coinalyze.net to get your API key
COINANALYZE_API_KEY=your_coinalyze_api_key_here
# Rate limiting (proactive; keep well under observed limits)
COINANALYZE_RPS=0.2  # lowered for ohlcv-history stability; header-aware client respects server signals
COINANALYZE_MAX_CONCURRENT=5

# Telegram Bot Configuration
# Create a bot via @BotFather on Telegram to get your token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Can be a user ID, group ID, or channel username (e.g. -100xxxxxxxxx or @channelname)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Command polling is disabled unless at least one of these allowlists is set.
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=

# Discord webhooks (optional). Leave empty to disable.
# Alpha signals use DISCORD_ALPHA_WEBHOOK_URL; OI falls back to it if OI URL is empty.
DISCORD_ALPHA_WEBHOOK_URL=
DISCORD_OI_WEBHOOK_URL=
BINANCE_OI_DISCORD_TOP_N=5
BINANCE_OI_DISCORD_MULTI_HOUR_WINDOW=6
BINANCE_OI_DISCORD_SKIP_EMPTY=true

# Database Configuration
# Separate SQLite files: gateway market observations and analyst state.
MARKET_DB_PATH=./data/market.sqlite3
ANALYST_DB_PATH=./data/analyst.sqlite3

# Scheduling & Ingestion Configuration
# Run the ingestion loop every X minutes (daemon default: 15)
INGEST_INTERVAL_MINS=5  # retained for compatibility; evaluation is trigger-driven
EVALUATION_TRIGGER_DIR=./data/evaluation_triggers
EVALUATION_RECOVERY_SCAN_SECONDS=5
EVALUATION_LEASE_SECONDS=600
EVALUATION_MAX_RETRIES=5
# Keep raw futures data for alpha research (0 disables pruning; default: 365)
FUTURES_RETENTION_DAYS=365
# Scanner research universe: require this much Binance 24h USDT notional
SCANNER_MIN_24H_VOLUME_USD=5000000
# Classify contracts at or above this Binance 24h USDT notional as core
SCANNER_CORE_24H_VOLUME_USD=100000000
# Number of liquid contracts sent to CoinAnalyze for detailed hourly scanning
SCANNER_MAX_CONTRACTS=50
# Binance-native USD-M perpetual OI rotation discovery (runs only completed UTC hours)
BINANCE_OI_ROTATION_ENABLED=true
BINANCE_OI_ROTATION_MIN_24H_VOLUME_USD=5000000
# 0 scans every liquidity-qualified contract; set a positive emergency safety cap only.
BINANCE_OI_ROTATION_MAX_CONTRACTS=0
BINANCE_OI_ROTATION_HISTORY_HOURS=168
BINANCE_OI_ROTATION_MIN_OI_DELTA_USD=1000000
BINANCE_OI_ROTATION_MIN_OI_PERCENTILE=0.95
BINANCE_OI_ROTATION_MIN_VOLUME_ANOMALY=1.0
BINANCE_OI_ROTATION_WATCHLIST_HOURS=36
BINANCE_OI_ROTATION_FEED_EXPIRY_HOURS=6

# Binance OI 10m/15m liquid fast path (additive to 1h full; same feed contract)
BINANCE_OI_10M_ENABLED=true
BINANCE_OI_10M_BAR_MINUTES=15
BINANCE_OI_10M_MIN_24H_VOLUME_USD=5000000
BINANCE_OI_10M_MAX_CONTRACTS=100
BINANCE_OI_10M_MIN_OI_DELTA_USD=250000
BINANCE_OI_10M_MIN_OI_PERCENTILE=0.95
BINANCE_OI_10M_MIN_VOLUME_ANOMALY=1.0
BINANCE_OI_10M_HISTORY_BARS=672
BINANCE_OI_10M_DISCORD_ENABLED=true
BINANCE_OI_10M_FEED_MERGE_HOURLY=true

# Time to send the daily brief (in WITA / Asia/Makassar timezone)
DAILY_BRIEF_TIME_WITA=08:00

# Local-evidence LLM research is disabled until explicitly enabled and budgeted.
LLM_RESEARCH_ENABLED=false
LLM_PROVIDER=openai
# LLM endpoint: local 9router (OpenAI-compatible).
# Empty LLM_BASE_URL -> api.openai.com. The PM sidecar uses this for position-management
# decisions when PM_SIDECAR_ENABLED=true.
LLM_BASE_URL=http://127.0.0.1:20128/v1
LLM_MODEL=ag/gemini-3.7-flash-high
LLM_API_KEY=sk-REPLACE_WITH_9ROUTER_KEY
LLM_TIMEOUT_SECONDS=20
LLM_MAX_REPORTS_PER_CYCLE=2
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=60
LLM_MAX_INPUT_CHARS=24000
LLM_MAX_OUTPUT_CHARS=6000
LLM_MONTHLY_BUDGET_USD=5
LLM_INCLUDE_IN_TELEGRAM=false
LLM_INCLUDE_IN_DISCORD=false
LLM_PRICING_VERSION=openai-chat-2026-08-v1
LLM_INPUT_COST_PER_1K_USD=0
LLM_OUTPUT_COST_PER_1K_USD=0
# Max additive delivery-order boost from LLM review (not confidence / not emit gate)
LLM_BOOST_CAP=0.10

# Research-to-bot execution delivery. All targets are disabled by default.
# These are shared inbox paths only; do not put exchange credentials here.
EXECUTION_OUTBOX_DIR=./data/execution_outbox
EXECUTION_BYBIT_ENABLED=false
EXECUTION_BYBIT_ASSET_ALLOWLIST=
EXECUTION_BYBIT_TEST_ENABLED=false
EXECUTION_BYBIT_TEST_ASSET_ALLOWLIST=
EXECUTION_MEXC_ENABLED=false
EXECUTION_MEXC_ASSET_ALLOWLIST=
EXECUTION_PROPR_ENABLED=false
EXECUTION_PROPR_TRADEABLE_ASSETS_PATH=./data/propr_tradeable_assets.json

# ---------------------------------------------------------------------------
# WebSocket market-data ingestion (replaces legacy CoinAnalyze REST for bars)
# ---------------------------------------------------------------------------
# Source streams. Bybit on by default; Binance off. Both write source_observations
# (single writer). 15m/1h/4h are resampled locally from the 5m base.
WS_BYBIT_ENABLED=true
WS_BINANCE_ENABLED=false
WS_STREAM_TIMEFRAMES=1m,5m
# Universe: static approved-symbol only; Binance OI rotation is a separate feature.
WS_SYMBOL_SOURCE=static
COINANALYZE_EVAL_ENABLED=false
LEGACY_SCANNER_ENABLED=false
BINANCE_OI_ROTATION_ENABLED=false

# Strategy evaluation intervals (completed-bar cutoffs). HTF 1h/4h are enrichment only.
EVAL_INTERVALS=1m,5m,15m

# Runtime enable/disable of strategy plugins without code changes. Empty = all enabled
# plugins are active. Comma-separated strategy_ids to restrict (e.g. accumulation-base-v2).
STRATEGY_ACTIVE_IDS=

# ---------------------------------------------------------------------------
# Executor integration — bybit-executor (trade-intent handoff)
# ---------------------------------------------------------------------------
# Point this at the executor repo root. INTENT_INBOX then resolves to
# <BYBIT_EXECUTOR_DIR>/data/intents — the executor's own default inbox — with no
# guessing. If the executor overrides its INTENT_INBOX, set INTENT_INBOX to the same
# absolute path. Sizing is executor-owned; the intent carries NO quantity/risk_amount.
BYBIT_EXECUTOR_DIR=/home/ubuntu/bybit-executor
# Master switch for emitting executor TradeIntent envelopes (schema_version 1).
INTENT_DELIVERY_ENABLED=false
# INTENT_INBOX is the shared directory consumed by bybit-executor.
INTENT_INBOX=/home/ubuntu/bybit-executor/data/intents
INTENT_SOURCE=research-analyst
INTENT_EXCHANGE_ID=bybit
INTENT_ACCOUNT_ID=hyro
INTENT_ORDER_TYPE=limit
INTENT_TAKE_PROFIT_MODE=fixed_full_close
INTENT_VALIDITY_MINUTES=5
INTENT_MIN_RR=2.0
INTENT_MIN_STOP_DISTANCE_PCT=0.001
INTENT_MIN_STOP_ATR_MULTIPLIER=0.25
INTENT_MAX_STOP_DISTANCE_PCT=0.05
# Per-strategy routing to executor profiles. JSON map keyed by strategy_id; each entry
# may override exchange_id, account_id, source, order_type, take_profit_mode,
# validity_minutes. Strategies not listed fall back to the INTENT_* defaults above.
# Compact strategies are forced to bybit account `hyro`; do not add routing
# overrides for them.

# ---------------------------------------------------------------------------
# PM sidecar (emit-only position-management advice; enabled by default)
# ---------------------------------------------------------------------------
# Reads open positions from the executor's 1m snapshots + the originating intent +
# HTF bias, then emits hold|exit|reduce|near_tp to pm_advice and PMDecision files.
# These default from BYBIT_EXECUTOR_DIR; override them if the executor uses custom paths.
PM_SIDECAR_ENABLED=true
PM_CADENCE_MINUTES=5
EXECUTOR_SNAPSHOT_DIR=/home/ubuntu/bybit-executor/data/position-snapshots
EXECUTOR_DECISION_DIR=/home/ubuntu/bybit-executor/data/position-decisions
PM_REDUCE_FRACTION=0.5
PM_DECISION_VALIDITY_MINUTES=5
PM_ACTION_CONFIDENCE=0.70
PM_NEAR_TP_REDUCE_FRACTION=0.75

# ---------------------------------------------------------------------------
# Data retention
# ---------------------------------------------------------------------------
# Tiered prune of source_observations per interval (days). 0 disables that tier;
# any interval not listed here falls back to FUTURES_RETENTION_DAYS.
PRUNE_1M_DAYS=7
PRUNE_5M_DAYS=30
PRUNE_15M_DAYS=90
PRUNE_1H_DAYS=365
PRUNE_4H_DAYS=365

# Rotation feed: export active Binance OI rotation members to the WS universe feed.
# Also requires WS_SYMBOL_SOURCE=rotated|both. Disabled by default.
ROTATION_FEED_ENABLED=false

# Upstream performance rotation. This is independent from the Binance OI feed.
SYMBOL_ROTATION_ENABLED=true
SYMBOL_ROTATION_REFRESH_HOURS=4
SYMBOL_ROTATION_LOOKBACK_HOURS=24
SYMBOL_ROTATION_ROTATING_SYMBOL_COUNT=30
SYMBOL_ROTATION_BAR_INTERVAL=5m
SYMBOL_ROTATION_FEED_PATH=./data/symbol_rotation_feed.json
SYMBOL_ROTATION_SOURCE_MAX_AGE_HOURS=6

# Regime Signal Configuration
# (Data is sourced from the SQLite source_observations table — no external files needed; futures_data dropped post-cutover)

# Strategy plugins (comma-separated). Retired dual-zone v1 IDs are not live plugins.
STRATEGY_ENABLED_IDS=failed-break-v3,bb-rsi-meanrev-v1,williams-fractal-scalp-v1,ema9-continuation-stochrsi-v1,dual-zone-follower-v2,dual-zone-short-follower-v2,ema20-pullback-h4-trend-v1,ema-stack-15m-adx-stochrsi-5m-v1

# accumulation-base-v2 (tighter coil / emit floor — grilled defaults)
ACC_V2_N=12
ACC_V2_K=2.0
ACC_V2_G=0.25
ACC_V2_D_MAX=0.50
ACC_V2_R_MAX=2.5
ACC_V2_S_MIN=0.55
ACC_V2_N_TOP=3

# impulse-ignition-v2
IGN_V2_N=12
IGN_V2_K=2.0
IGN_V2_P=20
IGN_V2_C_RATIO=0.85
IGN_V2_G=0.25
IGN_V2_E=0.35
IGN_V2_R_MAX=2.5
IGN_V2_S_MIN=0.55
IGN_V2_N_TOP=3

# continuation-breakout-v2
CONT_V2_P=12
CONT_V2_T_MIN=1.0
CONT_V2_N=12
CONT_V2_K=2.0
CONT_V2_RETR_MAX=0.40
CONT_V2_G=0.25
CONT_V2_E=0.35
CONT_V2_X_BARS=96
CONT_V2_X_MAX=3.0
CONT_V2_R_MAX=2.5
CONT_V2_S_MIN=0.55
CONT_V2_N_TOP=3
# early | balanced | confirmed (snapshot/config only; not in strategy_id)
CONT_V2_WEIGHT_PROFILE=balanced

# rsi-reclaim-v1 (15m RSI pullback + EMA reclaim; disabled until added to STRATEGY_ENABLED_IDS)
RSI_RECLAIM_EMA_FAST=20
RSI_RECLAIM_EMA_MID=50
RSI_RECLAIM_RSI_LEN=14
RSI_RECLAIM_RSI_MAX=45.0
RSI_RECLAIM_RSI_MIN=55.0
RSI_RECLAIM_PULLBACK_TOL=0.0008
RSI_RECLAIM_BODY_ATR_MIN=0.20
RSI_RECLAIM_SEP_MIN=0.003
RSI_RECLAIM_SEP_MAX=0.04
RSI_RECLAIM_R_MAX=2.5
RSI_RECLAIM_S_MIN=0.55
RSI_RECLAIM_N_TOP=3

# liquidity-sweep-reversal-v1 (LSR) — PDH/PDL sweep reversal; opt-in only
# LSR_V1_* per specs/strategy-liquidity-sweep-reversal-v1.md
# Add "liquidity-sweep-reversal-v1" to STRATEGY_ENABLED_IDS to activate.
LSR_V1_S_MIN=0.55
LSR_V1_N_TOP=3
LSR_V1_R_MAX=3.0
LSR_V1_SWEEP_MIN_ATR=0.10
LSR_V1_SWEEP_MAX_ATR=1.00
LSR_V1_STOP_ATR_BUF=0.15
LSR_V1_RETRACE_PCT=0.50
LSR_V1_BOS_WINDOW=8
LSR_V1_ENTRY_HORIZON_MIN=120
LSR_V1_TARGET_R=2.0
LSR_V1_REQUIRE_DISPLACEMENT=false
LSR_V1_REQUIRE_CLOSE_LOCATION=false
LSR_V1_FVG_SNAP_ATR=0.25
LSR_V1_USE_15M_EPHEMERAL_FVG=true

# bot-health-watchdog integration (non-trading bot)
RESEARCH_HEALTH_PATH=/home/ubuntu/research-analyst/data/health.json

# LLM for future research features (disabled by default)
# LLM_RESEARCH_ENABLED=true
# LLM_PROVIDER=openrouter
# LLM_MODEL=openai/gpt-5.6-luna
# LLM_API_KEY=sk-or-...

# CA + Binance/Bybit venue-aggregate failover for 15m bars (ship dark; see specs/ca-truth-venue-agg-failover.md)
# MARKET_FAILOVER_ENABLED=false
# FAILOVER_CATCHUP_HOURS=2
# FAILOVER_WATCHLIST_CAP=20
# FAILOVER_MAX_REQUESTS_PER_CYCLE=80
# FAILOVER_CIRCUIT_AGE_MIN=30
# FAILOVER_CIRCUIT_CLEAR_AGE_MIN=20
# FAILOVER_CIRCUIT_429_RATE=0.50
# FAILOVER_CIRCUIT_CLEAR_429_RATE=0.25
# FAILOVER_CIRCUIT_WINDOW_MIN=30
# CA shaping (when circuit open, skip non-critical CA calls to protect quota + let failover takeover)
# CA_SHAPE_ON_CIRCUIT=true
# CA_SHAPE_SKIP_SECONDARY=true
# FAILOVER_FUNDING_PRIORITY=true
# MARKET_FAILOVER_ENABLED=true
# BYBIT_LINEAR_BASE_URL=https://api.bybit.com
# BINANCE_FUTURES_BASE_URL=https://fapi.binance.com (already set above)
# Optional observation-only Discord batches. Keep disabled unless the webhook is configured.
RAW_SIGNAL_DISCORD_BATCH_ENABLED=false
RAW_SIGNAL_DISCORD_BATCH_MINUTES=30
RAW_SIGNAL_DISCORD_WEBHOOK_URL=${DISCORD_ALPHA_WEBHOOK_URL}
RAW_BATCH_CLAIM_LEASE_SECONDS=120
RAW_BATCH_MAX_ATTEMPTS=5
