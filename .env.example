# CoinAnalyze Configuration
# Register on coinalyze.net to get your API key
COINANALYZE_API_KEY=your_coinalyze_api_key_here
# Rate limiting (proactive; keep well under observed limits)
COINANALYZE_RPS=0.2  # lowered for ohlcv-history stability; header-aware client respects server signals
COINANALYZE_MAX_CONCURRENT=5

# Telegram Bot Configuration
# Create a bot via @BotFather on Telegram to get your token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Can be a user ID, group ID, or channel username (e.g. -100xxxxxxxxx or @channelname)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Command polling is disabled unless at least one of these allowlists is set.
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=

# Discord webhooks (optional). Leave empty to disable.
# Alpha signals use DISCORD_ALPHA_WEBHOOK_URL; OI falls back to it if OI URL is empty.
DISCORD_ALPHA_WEBHOOK_URL=
DISCORD_OI_WEBHOOK_URL=
BINANCE_OI_DISCORD_TOP_N=5
BINANCE_OI_DISCORD_MULTI_HOUR_WINDOW=6
BINANCE_OI_DISCORD_SKIP_EMPTY=true

# Database Configuration
# Relative or absolute path to the DuckDB database file
DB_PATH=./data/market_data.db
# Dedicated publisher ledger. It must not be the same file as DB_PATH.
ALPHA_DB_PATH=./data/alpha_events.db

# Scheduling & Ingestion Configuration
# Run the ingestion loop every X minutes (daemon default: 15)
INGEST_INTERVAL_MINS=15
# Keep raw futures data for alpha research (0 disables pruning; default: 365)
FUTURES_RETENTION_DAYS=365
# Scanner research universe: require this much Binance 24h USDT notional
SCANNER_MIN_24H_VOLUME_USD=5000000
# Classify contracts at or above this Binance 24h USDT notional as core
SCANNER_CORE_24H_VOLUME_USD=100000000
# Number of liquid contracts sent to CoinAnalyze for detailed hourly scanning
SCANNER_MAX_CONTRACTS=50
# Binance-native USD-M perpetual OI rotation discovery (runs only completed UTC hours)
BINANCE_OI_ROTATION_ENABLED=true
BINANCE_OI_ROTATION_MIN_24H_VOLUME_USD=5000000
# 0 scans every liquidity-qualified contract; set a positive emergency safety cap only.
BINANCE_OI_ROTATION_MAX_CONTRACTS=0
BINANCE_OI_ROTATION_HISTORY_HOURS=168
BINANCE_OI_ROTATION_MIN_OI_DELTA_USD=1000000
BINANCE_OI_ROTATION_MIN_OI_PERCENTILE=0.95
BINANCE_OI_ROTATION_MIN_VOLUME_ANOMALY=1.0
BINANCE_OI_ROTATION_WATCHLIST_HOURS=36
BINANCE_OI_ROTATION_FEED_EXPIRY_HOURS=6
# Time to send the daily brief (in WITA / Asia/Makassar timezone)
DAILY_BRIEF_TIME_WITA=08:00

# Local-evidence LLM research is disabled until explicitly enabled and budgeted.
LLM_RESEARCH_ENABLED=false
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_REPORTS_PER_CYCLE=2
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=60
LLM_MAX_INPUT_CHARS=24000
LLM_MAX_OUTPUT_CHARS=6000
LLM_MONTHLY_BUDGET_USD=0
LLM_INCLUDE_IN_TELEGRAM=false
LLM_INCLUDE_IN_DISCORD=false
LLM_PRICING_VERSION=openai-chat-2026-08-v1
LLM_INPUT_COST_PER_1K_USD=0
LLM_OUTPUT_COST_PER_1K_USD=0
# Max additive delivery-order boost from LLM review (not confidence / not emit gate)
LLM_BOOST_CAP=0.10

# Research-to-bot execution delivery. All targets are disabled by default.
# These are shared inbox paths only; do not put exchange credentials here.
EXECUTION_OUTBOX_DIR=./data/execution_outbox
EXECUTION_BYBIT_ENABLED=false
EXECUTION_BYBIT_ASSET_ALLOWLIST=
EXECUTION_BYBIT_TEST_ENABLED=false
EXECUTION_BYBIT_TEST_ASSET_ALLOWLIST=
EXECUTION_MEXC_ENABLED=false
EXECUTION_MEXC_ASSET_ALLOWLIST=
EXECUTION_PROPR_ENABLED=false
EXECUTION_PROPR_TRADEABLE_ASSETS_PATH=./data/propr_tradeable_assets.json

# Regime Signal Configuration
# (Data is sourced from the DuckDB source_observations table — no external files needed; futures_data dropped post-cutover)

# OpenMarket Free (optional enrichment for selected universe on Bybit Perp)
# Disabled by default; set key and enabled=true after providing credentials.
# API key is the JWT from OpenMarket (X-OpenMarket-Key header)
OPENMARKET_ENABLED=false
OPENMARKET_API_KEY=
OPENMARKET_REFERENCE_VENUE=BYBIT
OPENMARKET_PERMANENT_ASSETS=BTC,ETH,SOL,PAXG,XAUT
OPENMARKET_CANDIDATE_CAP=30
OPENMARKET_HTF_REFRESH_HOURS=4
OPENMARKET_REQUEST_DEADLINE_MS=1500
OPENMARKET_RETENTION_DAYS=30
# Budgeting (Free tier ~1000 weight/day; tune per cutoff)
OPENMARKET_DAILY_WEIGHT_BUDGET=1000
OPENMARKET_PER_CUTOFF_WEIGHT=50

# Strategy plugins (comma-separated). v1 + v2 run in parallel until v1 is disabled.
STRATEGY_ENABLED_IDS=accumulation-base-v1,impulse-ignition-v1,continuation-breakout-balanced-v1,accumulation-base-v2,impulse-ignition-v2,continuation-breakout-v2

# accumulation-base-v2 (tighter coil / emit floor — grilled defaults)
ACC_V2_N=12
ACC_V2_K=2.0
ACC_V2_G=0.25
ACC_V2_D_MAX=0.50
ACC_V2_R_MAX=2.5
ACC_V2_S_MIN=0.55
ACC_V2_N_TOP=3

# impulse-ignition-v2
IGN_V2_N=12
IGN_V2_K=2.0
IGN_V2_P=20
IGN_V2_C_RATIO=0.85
IGN_V2_G=0.25
IGN_V2_E=0.35
IGN_V2_R_MAX=2.5
IGN_V2_S_MIN=0.55
IGN_V2_N_TOP=3

# continuation-breakout-v2
CONT_V2_P=12
CONT_V2_T_MIN=1.0
CONT_V2_N=12
CONT_V2_K=2.0
CONT_V2_RETR_MAX=0.40
CONT_V2_G=0.25
CONT_V2_E=0.35
CONT_V2_X_BARS=96
CONT_V2_X_MAX=3.0
CONT_V2_R_MAX=2.5
CONT_V2_S_MIN=0.55
CONT_V2_N_TOP=3
# early | balanced | confirmed (snapshot/config only; not in strategy_id)
CONT_V2_WEIGHT_PROFILE=balanced
