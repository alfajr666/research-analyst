# Research Analyst deployment overrides
#
# Runtime defaults live in src/research_analyst/config.py. Copy this file only
# when a deployment needs paths, credentials, or an explicit opt-in. Leaving a
# variable unset preserves the tested default.

# Shared intent bus. INTENT_BUS_DB must be an absolute path.
INTENT_BUS_DB=
# INTENT_BUS_PACKAGE_DIR=/home/ubuntu/shared/intent-bus
# INTENT_BUS_BYBIT_ENABLED=true
# INTENT_BUS_PROPR_ENABLED=true

# Optional executor position snapshots retained in the market subscription.
EXECUTOR_SNAPSHOT_DIR=

# Advisory raw-signal Discord batch. Individual alpha Telegram/Discord delivery
# is a retirement target in specs/repository-cleanup-v1.md.
RAW_SIGNAL_DISCORD_WEBHOOK_URL=
# RAW_SIGNAL_DISCORD_BATCH_ENABLED=true

# Optional local operator controls.
# RESEARCH_ANALYST_LOCAL_CLI_ENABLED=false
# RESEARCH_HEALTH_PATH=./data/health.json

# Production defaults are intentionally not repeated here:
# - seven vectorbt strategy ports
# - 160-symbol sticky watchlist cap
# - 5m evaluation cadence
# - shadow regime/session mode
# - bounded retention from config.py
