[TEMPLATE]
# Research Analyst deployment overrides — mirrors the live production env.
#
# Runtime defaults live in src/research_analyst/config.py. Copy to .env,
# fill the two SECRETS marked below, then restrict permissions:
#   cp .env.example .env && chmod 600 .env
# Leaving a variable unset preserves the tested default. Values shown here
# are the current production setting (all rollout modes enforce).
#
# NOTE: REGIME_SESSION_MODE is also set per-process in ops/oxfile.toml
# oxmgr overlays, which win over .env (dotenv never overrides real environ).
# Keep both in sync when changing it.

# --- Rollout modes: off | shadow | enforce (production: all enforce) ---
REACTION_SCORER_MODE=enforce
LLM_THESIS_REVIEW_MODE=enforce
ENTRY_POLICY_MODE=enforce
REGIME_SESSION_MODE=enforce

# --- Independent LLM thesis reviewer (specs/llm-thesis-review-v1.md) ---
# Z.ai-compatible adapter pointed at the local OpenAI-compatible proxy.
# Timeout must exceed real reviewer latency (~5-6s with reasoning tokens);
# the spec default of 3s times out every real review on this proxy.
# Unconfigured/unreachable providers fail open and record `unavailable` rows.
THESIS_REVIEW_PROVIDER=zai
THESIS_REVIEW_MODEL=ag/gemini-3.7-flash-high
THESIS_REVIEW_BASE_URL=http://127.0.0.1:20128/v1
THESIS_REVIEW_TIMEOUT_SECONDS=10
# SECRET: OpenAI-compatible bearer key for the proxy above.
THESIS_REVIEW_API_KEY=

# --- Shared SQLite intent bus. INTENT_BUS_DB must be an absolute path. ---
INTENT_BUS_DB=/home/ubuntu/shared/intent-bus/intent_bus.sqlite3
INTENT_BUS_BYBIT_ENABLED=true
INTENT_BUS_PROPR_ENABLED=true

# --- Advisory raw-signal Discord batch (only notification surface) ---
RAW_SIGNAL_DISCORD_BATCH_ENABLED=true
RAW_SIGNAL_DISCORD_BATCH_MINUTES=30
# SECRET: Discord webhook URL (alpha + OI + raw share one channel).
RAW_SIGNAL_DISCORD_WEBHOOK_URL=

# --- Executor position snapshots retained in the market subscription ---
EXECUTOR_SNAPSHOT_DIR=/home/ubuntu/bybit-executor/data/position-snapshots

# --- Optional local operator controls (defaults are correct) ---
# INTENT_BUS_PACKAGE_DIR=/home/ubuntu/shared/intent-bus
# RESEARCH_ANALYST_LOCAL_CLI_ENABLED=false
# RESEARCH_HEALTH_PATH=./data/health.json

# --- Explicit non-default strategy surface ---
EVAL_INTERVALS=5m
STRATEGY_ENABLED_IDS=bb-tp-race-locked-v1,bb-squeeze-trend-v1,kama-trend-following-v1,macd-ema-v1,mr-vwap-locked-v1,trend-pullback-vwap-v1,trend-wall-v5
STRATEGY_ACTIVE_IDS=bb-tp-race-locked-v1,bb-squeeze-trend-v1,kama-trend-following-v1,macd-ema-v1,mr-vwap-locked-v1,trend-pullback-vwap-v1,trend-wall-v5
SYMBOL_ROTATION_WATCHLIST_MAX_SYMBOLS=160

# Production defaults intentionally not repeated here:
# - seven vectorbt strategy ports
# - 5m evaluation cadence (set explicitly above because it is load-bearing)
# - shadow regime/session mode (overridden to enforce above)
# - bounded retention from config.py
